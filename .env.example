# Railway / production
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION_MINUTES=480
JWT_COOKIE_SECURE=true

# Railway MySQL plugin provides these automatically when linked.
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# First admin user. Set once before the first deploy, then rotate/remove ADMIN_PASSWORD after login.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
ADMIN_ROLE=ADMIN

WHATSAPP_NUMBER=51910872665
RESERVATION_FEE=20.00

# Opinion email notifications. Example for SMTP providers such as Gmail, Brevo, Mailgun or Resend SMTP.
OPINION_EMAIL_ENABLED=false
OPINION_EMAIL_TO=restaurante@suuit.dev
MAIL_FROM="Rinconcito Marino <no-reply@suuit.dev>"
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
DDL_AUTO=update
